{
  "name": "proyecto-fmb-global",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión global de Frontend y Backend",
  "scripts": {
    "install-all": "npm install --prefix frontend && npm install --prefix backend",
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm:dev-backend\" \"npm:dev-frontend\"",
    "build-frontend": "npm run build --prefix frontend",
    "migrate": "npm run migrate --prefix backend",
    "migrate-seed": "npm run migrate --prefix backend -- --seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}