# Copia este archivo como ".env" y completa los valores.
# En Railway estas variables se configuran en Settings -> Variables del
# servicio backend (ver DEPLOY.md en la raíz del proyecto).

# --- Base de datos MySQL ---
# Opción A: variables sueltas (recomendado para XAMPP / desarrollo local)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fisiomathbot
JWT_SECRET=una-clave-larga-y-aleatoria
CORS_ORIGIN=http://localhost:5173



# Opción B: una sola URL de conexión (Railway la genera automáticamente
# como MYSQL_URL o MYSQL_PUBLIC_URL al crear el plugin de MySQL).
# Si DATABASE_URL está definida, tiene prioridad sobre las variables sueltas.
# DATABASE_URL=mysql://usuario:password@host:puerto/nombre_bd

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# --- CORS ---
# URL(s) del frontend permitidas, separadas por coma.
CORS_ORIGIN=http://localhost:5173

# --- Chat tutor (LLM) ---
# Proveedor: gemini | anthropic
LLM_PROVIDER=gemini
# Nombre del modelo. Con Gemini gratis usa uno "lite" (p. ej. gemini-3.1-flash-lite): los "flash" normales
# solo permiten 20 peticiones al día en el plan gratuito. Con anthropic, p. ej. claude-haiku-5-5.
LLM_MODEL=
# Solo se usa la clave del proveedor elegido. Sin clave/modelo el chat se muestra como "no disponible".
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Límites de uso y costo
CHAT_DAILY_MESSAGE_LIMIT=40
CHAT_MAX_OUTPUT_TOKENS=600
CHAT_HISTORY_TURNS=8

# (Opcional) carpeta de la base de conocimiento; por defecto backend/knowledge
# KNOWLEDGE_DIR=
# (Opcional, Gemini 3+) nivel de razonamiento: minimal | low | medium | high. Vacío = no se envía.
# GEMINI_THINKING_LEVEL=minimal
